# Required. Set through your backend secret manager; never expose to the frontend.
ADMIN_SECRET=
MONGO_URI=
PORT=5000

# Required for browser clients; required at startup with NODE_ENV=production.
# Exact origins only, comma-separated. Set actual deployed frontend origins.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional per-client-IP maxima. Auth, admin and public write windows: 15 minutes.
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=60
PUBLIC_WRITE_RATE_LIMIT_MAX=20
# Chat and external breach windows: 1 minute.
CHAT_RATE_LIMIT_MAX=60
BREACH_RATE_LIMIT_MAX=10

# Empty means trust no proxy. Set only verified proxy IPs/CIDRs, comma-separated.
TRUSTED_PROXY_CIDRS=
